{
  "name": "secret-hitman-5",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names web,game \"next dev --hostname $(node scripts/dev-host.mjs)\" \"cross-env NODE_ENV=development HOST=$(node scripts/dev-host.mjs) tsx watch server/index.ts\"",
    "dev:web": "next dev --hostname $(node scripts/dev-host.mjs)",
    "dev:server": "cross-env NODE_ENV=development HOST=$(node scripts/dev-host.mjs) tsx watch server/index.ts",
    "dev:e2e": "cross-env NEXT_PUBLIC_GAME_SERVER_URL=http://127.0.0.1:3225 concurrently --kill-others --names web,game \"next dev --hostname 127.0.0.1 --port 3125\" \"cross-env PORT=3225 ALLOWED_ORIGINS=http://127.0.0.1:3125 tsx server/index.ts\"",
    "build": "next build",
    "deploy:build": "pnpm deploy:check-env && pnpm build",
    "deploy:check-env": "node scripts/check-deployment-env.mjs",
    "deploy:smoke": "tsx scripts/smoke-game-server.ts",
    "start": "next start",
    "start:web": "next start",
    "start:server": "tsx server/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium && playwright test --project=firefox && playwright test --project=webkit",
    "test:server": "vitest run server"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.20",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^16.2.10",
    "posthog-js": "^1.404.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^29.1.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0"
}
