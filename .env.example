# Browser-visible game server endpoint. Leave unset for local development,
# where the app connects to the page host (localhost, LAN IP, *.local) on
# port 3200.
NEXT_PUBLIC_GAME_SERVER_URL=

# Game server runtime. tsx does not read this file — pass these as shell
# variables (e.g. HOST=0.0.0.0 pnpm dev) or set them in your deployment.
# Bind 0.0.0.0 to expose the game server to other devices on your LAN.
PORT=3200
HOST=127.0.0.1
# Explicit allowlist (required in production). Outside production,
# private-network origins (loopback, RFC1918 ranges, *.local) are also
# accepted by default; disable with ALLOW_PRIVATE_NETWORK_ORIGINS=false.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
